# Copy to .env and fill in. Never commit .env or the .pem file.
GITHUB_APP_ID=
GITHUB_WEBHOOK_SECRET=
# Path to the private key you download from the GitHub App settings page.
# docker-compose mounts ./github-app.pem at this path.
GITHUB_PRIVATE_KEY_PATH=/run/secrets/github-app.pem

# BYOK LLM review (all optional; leave empty for deterministic $0 summaries).
# LLM_PROVIDER: openai | anthropic. LLM_MODEL must match the provider
# (verified 2026-10-10: gpt-6-luna $0.10/$0.50, claude-haiku-5-5 $0.10/$0.50).
LLM_PROVIDER=
LLM_MODEL=gpt-6-luna
LLM_API_KEY=
LLM_MAX_INPUT_CHARS=60000
LLM_MAX_OUTPUT_TOKENS=1500
